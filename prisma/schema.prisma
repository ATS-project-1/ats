generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
}

enum ResumeSource {
  BUILDER
  UPLOAD
}

enum ApplicationStatus {
  SUBMITTED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

// ---------------------------------------------------------------------------
// Users & role profiles
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  role         Role
  status       UserStatus @default(PENDING_VERIFICATION)

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  statusChanges    ApplicationStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model CandidateProfile {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @unique @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String?
  location String?
  phone    String?

  resumes      Resume[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("candidate_profiles")
}

model RecruiterProfile {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @unique @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  isOrgAdmin     Boolean       @default(false)
  jobTitle       String?

  createdJobPostings JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("recruiter_profiles")
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

model Organization {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  website     String?

  recruiters  RecruiterProfile[]
  jobPostings JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Job postings
// ---------------------------------------------------------------------------

model JobPosting {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById    String?           @db.Uuid
  createdBy      RecruiterProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  title           String
  description     String
  requiredSkills  String[]         @default([])
  preferredSkills String[]         @default([])
  seniority       Seniority
  location        String
  isRemote        Boolean          @default(false)
  status          JobPostingStatus @default(DRAFT)
  publishedAt     DateTime?
  closedAt        DateTime?

  applications Application[]
  matchResults MatchResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status, seniority])
  @@index([requiredSkills], type: Gin)
  @@map("job_postings")
}

// ---------------------------------------------------------------------------
// Resumes & immutable versions
// ---------------------------------------------------------------------------

model Resume {
  id          String           @id @default(uuid()) @db.Uuid
  candidateId String           @db.Uuid
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  source      ResumeSource     @default(BUILDER)
  content     Json
  templateId  String?

  versions ResumeVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@map("resumes")
}

model ResumeVersion {
  id            String  @id @default(uuid()) @db.Uuid
  resumeId      String  @db.Uuid
  resume        Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       Json
  sourceFileKey String?
  rawText       String?

  applications Application[]
  matchResults MatchResult[]

  createdAt DateTime @default(now())

  @@unique([resumeId, versionNumber])
  @@map("resume_versions")
}

// ---------------------------------------------------------------------------
// Applications & status history
// ---------------------------------------------------------------------------

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  candidateId     String            @db.Uuid
  candidate       CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPostingId    String            @db.Uuid
  jobPosting      JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: NoAction)
  resumeVersionId String            @db.Uuid
  resumeVersion   ResumeVersion     @relation(fields: [resumeVersionId], references: [id], onDelete: NoAction)
  status          ApplicationStatus @default(SUBMITTED)

  statusHistory ApplicationStatusHistory[]
  interviews    Interview[]

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([candidateId, jobPostingId])
  @@index([jobPostingId, status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?            @db.Uuid
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note          String?
  changedAt     DateTime           @default(now())

  @@index([applicationId, changedAt])
  @@map("application_status_history")
}

// ---------------------------------------------------------------------------
// Matching
// ---------------------------------------------------------------------------

model MatchResult {
  id                  String        @id @default(uuid()) @db.Uuid
  resumeVersionId     String        @db.Uuid
  resumeVersion       ResumeVersion @relation(fields: [resumeVersionId], references: [id], onDelete: Cascade)
  jobPostingId        String        @db.Uuid
  jobPosting          JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  scorer              String
  score               Float
  breakdown           Json
  jobPostingUpdatedAt DateTime
  computedAt          DateTime      @default(now())

  @@unique([resumeVersionId, jobPostingId, scorer])
  @@index([jobPostingId, score])
  @@map("match_results")
}

// ---------------------------------------------------------------------------
// Interviews
// ---------------------------------------------------------------------------

model Interview {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @db.Uuid
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  status        InterviewStatus @default(SCHEDULED)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("interviews")
}

// ---------------------------------------------------------------------------
// Transactional outbox (used by the event-driven epic)
// ---------------------------------------------------------------------------

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
