# Runtime environment: development | production | test
NODE_ENV=development
# Port the HTTP server listens on (1-65535)
PORT=3000
# PostgreSQL connection string (postgresql:// or postgres://)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Secret used to sign JWTs (at least 32 characters)
JWT_SECRET=replace-with-a-long-random-string-of-32+-chars
# JWT lifetime, e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=1h
# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Tests: copy this file to .env.test (gitignored) with DATABASE_URL pointing at a separate
# `ats_test` database (docker-compose creates it). Apply migrations to it with
# `npm run test:db:prepare`, then run `npm test`.
